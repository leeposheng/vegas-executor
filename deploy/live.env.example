# ================================================================
# 維加斯執行層｜實盤第一階段設定
#
# 用法
#   VPS   ：複製到 /etc/vegas/vegas.env（chmod 600）後填入金鑰。
#   Zeabur：照這份逐項設定「環境變數」分頁。
#   兩邊用同一份內容。PORT 刻意不列：Zeabur 會自己注入，VPS 用預設 8080。
#   模擬服務（同時並行的第二個服務）用 deploy/shadow.env.example。
#
# 【絕對不要在 repo 裡的這份檔案填金鑰】填在 VPS 或 Zeabur 上的那一份。
#
# 格式規則（systemd 與程式內建讀取器都一樣）
#   1. 註解只能獨立一行，不可寫在值的後面（KEY=50 # 說明 會被當成值的一部分）
#   2. 值含特殊字元（$ & 空格 引號）時整個用單引號包住，例如 OKX_PASSPHRASE='a$b&c'
#   3. 值留空 ＝ 用程式預設；金鑰留空時 DRY_RUN=false 會拒絕啟動（這是保護）
#
# 標記：【必填】＝ 要你自己填　【改】＝ 依你的情況調整　其餘照抄
# ================================================================


# ---- 執行模式 ----
# 第一次開機（還沒拿到出口 IP、還沒建 OKX 實盤金鑰）先設 true，
# 完成 preflight 後再改成 false。
DRY_RUN=false
DEMO_MODE=false
EXECUTION_MODE=manual
AUTO_GRADE_MIN=3
PENDING_TTL_SEC=300

# 主服務：Apps Script 的按鈕卡片、面板都連到這裡
INSTANCE_ROLE=live

# 狀態檔目錄。一定要用新的子目錄，不可沿用模擬盤的 /data：
# 模擬盤當天的虧損會算進實盤日損、模擬部位會拿去跟實盤對帳。
# 狀態檔會記下自己屬於實盤或模擬盤，指錯目錄時服務會拒絕啟動。
DATA_DIR=/data/live


# ---- 連線密鑰（輪替後的新值）----
# 【必填】必須與 Apps Script 指令碼屬性 EXECUTOR_WEBHOOK_SECRET 完全相同
EXECUTOR_WEBHOOK_SECRET=
# 【必填】只放在執行層，絕不放進 Apps Script；必須與上面那把不同
EXECUTOR_CONTROL_SECRET=


# ---- 倉位：固定保證金 × 自動槓桿（現值的 1/4）----
# 單筆預估虧損約 5～9 USDT。止損低於約 0.4% 的訊號會因虧損低於下限被拒，這是預期行為。
# 想用 1/2 規模：FIXED_MARGIN_USDT=50、TARGET_LOSS_MIN_USDT=10、
# TARGET_LOSS_MAX_USDT=22、MAX_NOTIONAL_USDT=3000、日損兩項改 40。
SIZING_MODE=fixed_margin
FIXED_MARGIN_USDT=25
# 0 ＝ 不准自動加保證金（Zeabur 上若還留著 300 一定要改掉）
FIXED_MARGIN_MAX_USDT=0
TARGET_LOSS_MIN_USDT=5
TARGET_LOSS_MAX_USDT=11
TAKER_FEE_RATE=0.0005
# 槓桿峰值。自動槓桿只會往下調，不會超過這個數字。
LEVERAGE=40
AUTO_LEVERAGE=true
MIN_LIQ_CUSHION=3
# fixed_margin 模式下不生效，保留預設
RISK_PCT_PER_TRADE=0.005
# 逐倉：固定保證金「最多賠掉這筆保證金」的前提
OKX_TD_MODE=isolated


# ---- 名目上限 ----
# 正常名目 ＝ 25 × 40 ＝ 1000。絕對上限留 1.5 倍，只攔數量級錯誤。
MAX_NOTIONAL_USDT=1500
# 權益 × 3。入金低於約 340 USDT 時，這道會把槓桿壓到 40x 以下。
MAX_NOTIONAL_MULT=3


# ---- 權益 ----
EQUITY_SOURCE=exchange
EQUITY_CACHE_SEC=60
# 【改】查不到交易所時的退路。填你的入金額。
ACCOUNT_EQUITY_USDT=400


# ---- 持倉與加碼（第一階段全部收緊）----
MAX_CONCURRENT_POSITIONS=1
# Telegram 最多只能把上限調到 2
MAX_CONCURRENT_CEILING=2
# 0 ＝ 超額進場停用
OVERFLOW_POSITIONS=0
# 0 ＝ 加倉停用
ADDON_MAX=0
ADDON_REQUIRE_PROFIT=true


# ---- 日損 ----
# 約兩筆完整虧損。天花板設一樣，Telegram 就調不高。
DAILY_LOSS_LIMIT_USDT=20
DAILY_LOSS_CEILING_USDT=20
# 0 ＝ 關閉重置鍵：今天最多就是虧 20
DAILY_RESET_LIMIT=0
DAILY_RESET_COOLDOWN_MIN=30


# ---- 對帳（日損上限靠它，不可設 0）----
RECONCILE_SEC=60
RECONCILE_STALE_MIN=30


# ---- 訊號篩選（首週：單一幣種、單一週期）----
MIN_GRADE=2
# 【改】只留一個週期
ALLOWED_TIMEFRAMES=15
# 【改】只留一個幣，格式與 TradingView 代碼相同
ALLOWED_SYMBOLS=BTCUSDT.P
MAX_SIGNAL_AGE_SEC=60


# ---- 進場價漂移 ----
DRIFT_CHECK=true
DRIFT_MAX_WIDEN=1.5
DRIFT_MAX_TIGHTEN=0.75
REFRESH_SPEC=false


# ---- 交易所：只用 OKX ----
EXCHANGES=okx
PRIMARY_EXCHANGE=okx
OKX_BASE_URL=https://www.okx.com
# 【必填】OKX「實盤」API（不是模擬盤那組）。權限只勾讀取＋交易，綁定執行層的固定 IP。
OKX_API_KEY=
OKX_API_SECRET=
# 含特殊字元時用單引號包住
OKX_PASSPHRASE=

# BingX 的變數一個都不要設。Zeabur 上若有 BINGX_API_KEY／BINGX_API_SECRET／
# BINGX_BASE_URL，請刪除：BingX 金鑰同時碰得到真錢帳戶，不用就不該留在實盤環境。


# ---- 通知 ----
# 【必填】輪替後的新 bot token
TG_TOKEN=
# 【必填】你的私訊 chat id（與 Apps Script 的 ALLOWED_CHAT_ID 相同）
TG_CHAT_ID=
