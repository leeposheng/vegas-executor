# ================================================================
# 維加斯執行層｜模擬服務（shadow）設定
#
# 與實盤服務同時運作的第二個服務，從同一個 GitHub repo 部署。
# Apps Script 會把每一筆訊號另外轉一份過來（EXECUTOR_SHADOW_URL）。
#
# 用途
#   1. 每一筆訊號都在模擬盤自動執行 → 量測「策略本身」的期望值，
#      與實盤（只做你按了進場的）對照，差距就是人工篩選的價值
#   2. MIN_GRADE=1 → 三個等級都有資料，可以驗證分級有沒有區分力
#   3. 同時跑 BingX VST → 累積成交，供 BingX 逐筆損益歸戶驗證
#
# 保護
#   INSTANCE_ROLE=shadow 搭配 DEMO_MODE=false 會拒絕啟動。
#   狀態檔記下自己屬於模擬盤，指到實盤的目錄也會拒絕啟動。
#   每一則推播都會加「🧪 模擬服務」抬頭。
#
# 格式規則與 live.env.example 相同：註解獨立一行，值含特殊字元用單引號。
# 【必填】＝ 要你自己填
# ================================================================


# ---- 角色與模式 ----
INSTANCE_ROLE=shadow
DEMO_MODE=true
DRY_RUN=false
# 模擬服務的卡片沒有按鈕，必須 auto
EXECUTION_MODE=auto
AUTO_GRADE_MIN=3
PENDING_TTL_SEC=300
DATA_DIR=/data/shadow


# ---- 連線密鑰（不可與實盤服務共用）----
# 【必填】必須與 Apps Script 指令碼屬性 EXECUTOR_SHADOW_SECRET 相同
EXECUTOR_WEBHOOK_SECRET=
# 【必填】
EXECUTOR_CONTROL_SECRET=


# ---- 倉位：結構與實盤相同（固定保證金、自動槓桿、逐倉），規模沿用模擬盤 ----
# 比較的是 R 倍數與勝率，規模不同不影響比較。
SIZING_MODE=fixed_margin
FIXED_MARGIN_USDT=100
FIXED_MARGIN_MAX_USDT=0
TARGET_LOSS_MIN_USDT=20
TARGET_LOSS_MAX_USDT=45
TAKER_FEE_RATE=0.0005
LEVERAGE=40
AUTO_LEVERAGE=true
MIN_LIQ_CUSHION=3
RISK_PCT_PER_TRADE=0.005
OKX_TD_MODE=isolated
MAX_NOTIONAL_USDT=5000
MAX_NOTIONAL_MULT=3
EQUITY_SOURCE=exchange
EQUITY_CACHE_SEC=60
ACCOUNT_EQUITY_USDT=1000


# ---- 持倉與日損：放寬，目的是「每一筆都記錄到」----
# 兩家各算額度，每家最多 10 個
MAX_CONCURRENT_POSITIONS=10
MAX_CONCURRENT_CEILING=10
# 超額與加倉都需要按按鈕，模擬服務沒有按鈕，關閉
OVERFLOW_POSITIONS=0
ADDON_MAX=0
ADDON_REQUIRE_PROFIT=true
# 日損上限放到不會觸發。模擬服務被日損擋下，統計就少了那天後半段的訊號。
DAILY_LOSS_LIMIT_USDT=2000
DAILY_LOSS_CEILING_USDT=2000
DAILY_RESET_LIMIT=0
DAILY_RESET_COOLDOWN_MIN=30
RECONCILE_SEC=60
RECONCILE_STALE_MIN=30


# ---- 訊號篩選：全收 ----
# 1 ＝ 弱訊也做，三個等級都有樣本
MIN_GRADE=1
ALLOWED_TIMEFRAMES=15,60
# 留空 ＝ 內建的市值前 50 名單
ALLOWED_SYMBOLS=
MAX_SIGNAL_AGE_SEC=60
DRIFT_CHECK=true
DRIFT_MAX_WIDEN=1.5
DRIFT_MAX_TIGHTEN=0.75
REFRESH_SPEC=false


# ---- 交易所：OKX 模擬盤 ＋ BingX VST ----
EXCHANGES=okx,bingx
PRIMARY_EXCHANGE=okx
OKX_BASE_URL=https://www.okx.com
# 【必填】OKX「模擬交易」裡建立的模擬盤 API（就是目前 Zeabur 上那一組）
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
# 【必填】BingX 金鑰。務必綁 IP、關閉提現：這把金鑰同時碰得到 BingX 真錢帳戶
BINGX_API_KEY=
BINGX_API_SECRET=
# BINGX_BASE_URL 不要設。DEMO_MODE=true 時程式自動用 VST 網域；
# 填成真實盤網域會拒絕啟動，填成 VST 也可以但沒有必要。


# ---- 通知 ----
# 可以與實盤共用同一個 bot
TG_TOKEN=
# 【必填】建議另開一個只放模擬結果的聊天室，bot 要先加入
TG_CHAT_ID=
