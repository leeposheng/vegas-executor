# ================================================================
# 維加斯執行服務 設定範本
#
# 複製為 .env 後填入。.env 絕不可進版控（已列入 .gitignore）。
# ================================================================

# ---- 執行模式 ----
# true  = 只計算與記錄，不送出任何委託。階段 0 必須維持 true。
# false = 真實送單。切換前請完成 README 的上線檢查清單。
DRY_RUN=true

# true = 走交易所模擬盤（OKX x-simulated-trading / BingX VST）
DEMO_MODE=true

PORT=8080

# 狀態檔（state.json）的存放目錄。留空則用專案下的 data/。
# 【雲端部署必填】要指向掛載的持久磁碟，例如 Zeabur 掛在 /data。
# 漏掉這一項，每次重新部署狀態就清空 —— 冪等指紋沒了，
# 同一筆訊號會被重複下單。這是整個部署裡唯一會直接造成金錢損失的疏漏。
# DATA_DIR=/data

# ---- 下單決策模式 ----
# manual   = 算完存成待確認，等你按確認才下單（預設）
# auto     = 通過閘門就直接下單
# by_grade = 依品質等級決定：AUTO_GRADE_MIN 以上自動，其餘等確認
#
# 預設 manual 是刻意的：這個功能的目的就是讓人在迴圈裡，
# 若預設 auto，忘了設定就等於直接放手。
EXECUTION_MODE=manual

# by_grade 模式下，等級 >= 此值才自動下單。3=高品質 2=標準 1=弱訊
AUTO_GRADE_MIN=3

# 【重要】by_grade 的三段是由 MIN_GRADE 與 AUTO_GRADE_MIN 共同決定的：
#
#     等級 >= AUTO_GRADE_MIN          →  自動下單
#     MIN_GRADE <= 等級 < AUTO_GRADE_MIN  →  發卡片，等你按按鈕
#     等級 <  MIN_GRADE               →  直接拒絕，連卡片都沒有
#
# 所以「按鈕區間」是中間那一段。若 MIN_GRADE >= AUTO_GRADE_MIN，
# 這個區間是空的，by_grade 會退化成 auto（每一筆都自動下單）。
# 開機時會印出警告，但服務仍會啟動 —— 因為那也可能就是你的本意。
#
# 範例：高品質與標準自動進場、弱訊要人工確認
#     EXECUTION_MODE=by_grade
#     AUTO_GRADE_MIN=2
#     MIN_GRADE=1

# 待確認訊號的存活秒數，逾時自動失效。
# 300 秒是權衡：夠你掏出手機，又不至於用嚴重過時的價格進場。
PENDING_TTL_SEC=300

# ---- 連線密鑰 ----
# 各以 openssl rand -hex 32 產生，兩者必須不同。
# EXECUTOR_WEBHOOK_SECRET 會存在 Apps Script，外流風險較高；
# EXECUTOR_CONTROL_SECRET 只放本機，萬一前者外流也無法解除 kill switch。
EXECUTOR_WEBHOOK_SECRET=
EXECUTOR_CONTROL_SECRET=

# ---- 風控 ----
#
# 【倉位模式】兩種，槓桿的意義完全相反，換模式時不要沿用同一組直覺。
#
#   risk_pct      固定「虧損」＝ 權益 × RISK_PCT_PER_TRADE
#                 名目與保證金隨止損距離浮動。槓桿與風險無關，只決定鎖多少錢。
#
#   fixed_margin  固定「保證金」＝ FIXED_MARGIN_USDT
#                 名目 = 保證金 × 槓桿（確定值），虧損隨止損距離浮動。
#                 槓桿就是風險旋鈕。
#
#   虧損 = 保證金 × 槓桿 × 止損距離%  +  名目 × 費率 × 2
#
#   保證金 100、槓桿 40、費率 0.05% 時：
#      止損 0.40% → 虧損 20    止損 0.63% → 虧損 29
#      止損 1.02% → 虧損 45    止損 0.15% → 虧損  10（低於下限，拒單）
#   剛好涵蓋 15 分鐘訊號的典型止損範圍。
SIZING_MODE=risk_pct

# 以下只在 SIZING_MODE=fixed_margin 時生效 ------------------------
# 每筆投入的保證金。務必搭配 OKX_TD_MODE=isolated ——
# 全倉模式下整個帳戶都在背書，跳空時虧損不受這個數字限制。
FIXED_MARGIN_USDT=100

# 預估虧損（含來回手續費）必須落在這個區間，否則拒單。
# 這是本模式的主要保護：止損過緊代表訊號可疑或週期太短，
# 過寬代表這筆的代價超出你願意承受的範圍。
TARGET_LOSS_MIN_USDT=20
TARGET_LOSS_MAX_USDT=45

# 單邊 taker 費率。OKX 永續 VIP0 約 0.05%。
# 手續費約佔總虧損一成以上，不計入會系統性低估風險。
TAKER_FEE_RATE=0.0005
# ---------------------------------------------------------------

# 單筆風險佔權益比例（只在 SIZING_MODE=risk_pct 時生效）。
# 0.005 = 0.5%。上限 0.05，超過會拒絕啟動。
RISK_PCT_PER_TRADE=0.005

# 帳戶權益（USDT）—— 這是「退路」而非「設定」。
# 有 OKX 憑證時會向交易所查真值；查不到才用這個數字。
# 它永遠不會自己更新，所以只是保底，不要當成真相。
ACCOUNT_EQUITY_USDT=1000

# exchange = 向交易所查（預設）｜config = 只用上面那個數字
EQUITY_SOURCE=exchange

# 權益快取秒數。太短會在下單的關鍵路徑上多掛一次外部呼叫，
# 太長則在連續下單時用到過時的本金。
EQUITY_CACHE_SEC=60

# 同時最多持有幾個部位（預設值）
MAX_CONCURRENT_POSITIONS=3

# 持倉上限的「天花板」。在 Telegram 打「部位」會出現按鈕，
# 可以在 1 ～ 這個值之間即時調整，設定會存進狀態檔、撐得過重新部署。
#
# 【為什麼要兩層】
# 按「進場」只賭這一筆；改持倉上限是改往後所有交易的風險範圍。
# 天花板放在環境變數，只有能登入 Zeabur 的人改得到 ——
# 即使 Telegram 那端被冒用，也踩不過這條線。
MAX_CONCURRENT_CEILING=5

# 超額額度。達到持倉上限、而且只有這一道擋住時，訊號改成待確認卡片
# 並附「➕ 超額進場」按鈕，逐筆由你決定。硬上限 ＝ 目前上限 ＋ 這個值。
# 同標的重複、日損上限等其他閘門不能用這顆按鈕繞過；auto 模式下超額單
# 一樣要按按鈕。0 ＝ 停用（達上限一律拒絕）。只能在這裡改，Telegram 改不到。
OVERFLOW_POSITIONS=2

# 加倉。同一個幣、同一個方向的訊號再次出現，而且已持有該幣部位時，
# 不以「重複持倉」拒絕，改成待確認卡片＋「➕ 加倉進場」按鈕（auto 模式也要按）。
# 條件：交易所上確實有這個部位、方向相同、未用完次數；預設還要求浮盈為正。
# 加倉沿用原部位的實際槓桿（不跑自動槓桿），有自己的止損止盈，
# 不佔新的持倉額度。每個部位最多加幾次；0 ＝ 停用（同幣一律拒絕）。
ADDON_MAX=1
# 只在浮盈部位上加碼。false ＝ 虧損中也給加倉按鈕（等於允許攤平，風險結構不同）。
ADDON_REQUIRE_PROFIT=true

# 當日累計已實現虧損達此值（USDT）即停止下單。
# 【注意】這個上限完全依賴對帳迴圈 —— 沒有對帳就沒有已實現損益，
# 這道閘門會永遠讀到 0 而形同虛設。RECONCILE_SEC 設成 0 等於關掉它。
DAILY_LOSS_LIMIT_USDT=50

# ---- 日損上限的重置（Telegram 打「日損」→ 按鈕）----
#
# 當日最多能重置幾次。0 = 完全關閉重置鍵。
#
# 這個數字決定的是「當日最大虧損」的真正上限：
#   DAILY_RESET_LIMIT=0 → 最多虧 DAILY_LOSS_LIMIT_USDT × 1
#   DAILY_RESET_LIMIT=1 → 最多虧 DAILY_LOSS_LIMIT_USDT × 2
#   DAILY_RESET_LIMIT=2 → 最多虧 DAILY_LOSS_LIMIT_USDT × 3
# 設 50 搭配重置 1 次，實際意思就是「今天可能虧 100」。
# 決定這個值的時候請直接想那個乘出來的數字，不要想「重置幾次」。
DAILY_RESET_LIMIT=1

# 日損上限的天花板。Telegram 只能在 10 ～ 這個值之間調整。
# 留空的話預設是 max(100, DAILY_LOSS_LIMIT_USDT × 2) —— 跟著現值走，
# 所以新增這道限制不會讓任何既有設定啟動失敗。
DAILY_LOSS_CEILING_USDT=100

# 重置後的冷卻分鐘數。這段期間閘門照樣擋單。
#
# 日損上限擋的是額度，冷卻擋的是剛按完重置鍵的那個人。
# 連兩筆停損之後最貴的不是額度，是接下來半小時的判斷力。
# 設 0 就沒有冷卻。
#
# 【這是下限，不是預設值】Telegram 可以把冷卻調得更長，但調不短於它。
# 方向與日損上限相反，因為風險的方向相反：日損「調大」危險，
# 冷卻「調短」危險。一律只給天花板的話，這個參數會變成可以一鍵歸零的擺設。
DAILY_RESET_COOLDOWN_MIN=30

# 對帳間隔（秒）。0 = 停用。DRY_RUN=true 時自動停用（沒有真實部位可對）。
# 對帳負責：偵測止損／止盈觸發、記錄已實現損益、清掉已平倉的部位紀錄。
# 60 秒的取捨：推播最多慢一分鐘，但每天僅約 1440 次查詢，遠低於頻率限制。
RECONCILE_SEC=60

# 殘留判定時限（分鐘）。交易所已沒有某個部位、又查不到對應的平倉紀錄，
# 持續這麼久就放寬比對；仍對不上則釋放持倉額度並推播 Telegram（損益不入帳）。
# 沒有這個時限時，殘留部位會永遠佔著額度，系統認定滿倉而實際只有一兩個部位。
RECONCILE_STALE_MIN=30

# ---- 名目價值上限（兩道，取較嚴格者）----
#
# 正常單筆名目 = 權益 × 風險% ÷ 止損距離%，大約落在權益的 0.5～1.1 倍。
#   權益 1000、止損 0.45% → 名目 1111
#   權益 5000、止損 0.45% → 名目 5556
# 所以這個數字必須跟著權益走，否則權益一變就失準：
# 對小帳戶太鬆（攔不住任何東西），對大帳戶太緊（每一筆都被擋）。
#
# 絕對上限：「無論如何都不准超過」的硬天花板。
# 設成遠高於日常值，只在倉位算錯一個數量級時才會觸發。
MAX_NOTIONAL_USDT=5000

# 相對上限：權益的幾倍。這一個會跟著權益自動調整，是平常真正在把關的那道。
# 3 倍留有餘裕，又足以攔下數量級錯誤。
MAX_NOTIONAL_MULT=3

LEVERAGE=5

# ---- 自動槓桿（只在 SIZING_MODE=fixed_margin 下有效）----
#
# true 時每筆訊號的槓桿由止損距離反推，而不是固定用 LEVERAGE。
#
# 【唯一的方向保證：只會往下調】
# 起點永遠是 LEVERAGE，往下夾。所以開啟它只可能讓部位變小，
# 不可能變大 —— 這條性質讓它可以在真錢上開啟而不必重新評估風險上界。
#
# 解決的是「寬止損訊號被整批擋掉」：止損 3.2% 的訊號在 40x 下
# 虧損 132 USDT 直接超標，但更嚴重的是強平距離只有 2.5% ——
# 那筆單會先強平，止損根本輪不到觸發。
AUTO_LEVERAGE=false

# 保證金上限。只在 AUTO_LEVERAGE=true 時有意義。
#
# 自動模式的解法是「先用最小保證金配最高安全槓桿」，湊不到最低虧損
# 時才動保證金 —— 所以這個值只在一種情況下會被用到：
# 槓桿已頂到 LEVERAGE、名目還沒到上限、虧損卻仍低於下限。
#
# 【小帳戶用不到，這是對的】
# 名目上限 = 權益 × MAX_NOTIONAL_MULT。權益 1000、倍數 3 時上限 3000，
# 配保證金 100 就把槓桿壓到 30x，峰值 40x 碰不到，也就輪不到加保證金。
# 大約權益 1700 以上這個區間才開始運作。
#
# 留空或 0 = 等於 FIXED_MARGIN_USDT = 不准加保證金（與舊行為相同）。
FIXED_MARGIN_MAX_USDT=300

# 強平距離至少要是止損距離的幾倍。自動槓桿的主要約束。
# 3 代表止損 3.2% 時槓桿最高 10x（強平 10%）。
# 調大會讓倉位更小，小到虧損低於 TARGET_LOSS_MIN_USDT 時該筆會被拒絕。
MIN_LIQ_CUSHION=3

# 只接受此等級以上的訊號。3=高品質 2=標準 1=弱訊
MIN_GRADE=2

# 只接受這些週期（分鐘），逗號分隔
ALLOWED_TIMEFRAMES=5,15,30,60

# 要下單的交易所，逗號分隔。填兩家 = 同一筆訊號在兩邊各下一單。
#
# 【雙邊下單會讓曝險加倍】
# 兩家各用 FIXED_MARGIN_USDT 的保證金，所以總曝險與單筆最大虧損都是兩倍。
# DAILY_LOSS_LIMIT_USDT 沒跟著調的話，第一筆停損就會讓當天停止交易
# （開機時會警告）。
#
# 風控額度按交易所分開算：MAX_CONCURRENT_POSITIONS=3 是「每家最多三個」。
EXCHANGES=okx
# EXCHANGES=okx,bingx

# 允許交易的代碼，逗號分隔。留空 = 用程式內建的市值前 50 名單。
#
# 開機時會與交易所實際有的 USDT 永續取交集，對不上的自動剔除並在日誌列出，
# 所以填了不存在的代碼不會讓服務起不來。
#
# 合約規格（每張面值、最小下單量）不必在這裡填 —— 開機時向交易所取得。
#
# 【標的變多之後，這兩個值變得更重要】
# 五十個標的同時發訊號時，擋下多餘部位的是 MAX_CONCURRENT_POSITIONS
# 與 DAILY_LOSS_LIMIT_USDT，不是你的手速。上真錢前先確認它們是你願意
# 承受的數字。
# ALLOWED_SYMBOLS=BTCUSDT.P,ETHUSDT.P

# 訊號超過此秒數即視為過期並丟棄（重放保護）
MAX_SIGNAL_AGE_SEC=60

# ---- 進場價漂移檢查（按下確認的那一刻才生效）----
# 卡片躺在手機上那幾十秒，價格會動。止損不變的情況下，
# 進場價一偏，實際風險就不再是預算。這道檢查會以現價重算倉位，
# 偏太多則直接拒絕。關掉它等於接受「核准的與送出的不是同一筆交易」。
DRIFT_CHECK=true

# 風險距離最多可放大到原本的幾倍（進場價變差）。1.5 = 容許 0.5R 的漂移
DRIFT_MAX_WIDEN=1.5

# 風險距離最少要保留原本的幾成（進場價變好，但數量會膨脹）
DRIFT_MAX_TIGHTEN=0.75

# true = 每筆訊號都向交易所取一次合約規格，不用靜態表。
# 預設 false：規格極少變動，而這會在關鍵路徑上多掛一次外部呼叫。
# 靜態表是否過時，交給 npm run preflight 檢查。
REFRESH_SPEC=false

# ---- 交易所 ----
# 實際執行的交易所：okx 或 bingx
PRIMARY_EXCHANGE=okx

# ── OKX 金鑰 ──
#
# 【模擬盤與實盤的金鑰完全不通用】
#   DEMO_MODE=true 時，必須用「交易 → 模擬交易 → 個人中心 → 模擬盤 API」
#   建立的那一組。拿實盤金鑰過去會得到 50111（API Key 無效）。
#
# 【權限】只勾「讀取」與「交易」。
#   提現、劃轉、借貸、賺幣一律不勾 —— 那些才是「錢會不見」的路徑。
#
# 【Passphrase】是建立當下你自己輸入的字串，OKX 不保存明文。
#   忘記只能刪掉金鑰重建，務必當場記下。
#
# 【IP 白名單】跑在雲端時，要填的是「執行層的出口 IP」，不是你家的。
#   用 GET /control/whoami 可以查到，但請隔數小時重查幾次確認它不會變。
#   實盤前這一項必填；模擬盤階段可先留空。
#
# 【帳戶設定】以下兩項 API 改不了，必須在 OKX 網頁或 App 上設定：
#   帳戶模式 → 合約模式（或以上），否則不能交易永續合約
#   持倉模式 → 買賣模式（單向），邏輯較單純
#   執行 npm run preflight 會直接告訴你目前是什麼。
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
OKX_BASE_URL=https://www.okx.com
OKX_TD_MODE=cross

BINGX_API_KEY=
BINGX_API_SECRET=
# BINGX_BASE_URL=https://open-api.bingx.com
# ---- BingX 模擬盤（VST = Virtual USDT）----
#
# BingX 的模擬盤是「換網域」，不是像 OKX 那樣加一個標頭：
#   真實盤  https://open-api.bingx.com
#   模擬盤  https://open-api-vst.bingx.com
#
# 【留空就好】DEMO_MODE 會自動選對網域。
# 會特地做成自動，是因為忘記改的後果太嚴重：
# DEMO_MODE=true 但網域留在真實盤 → OKX 走模擬、BingX 走真錢，
# 同一筆訊號一邊假一邊真，而且沒有任何警告。
#
# 明確填了的話會被尊重（有人會用自架代理），但開機自檢會檢查
# 它與 DEMO_MODE 對不對得上，對不上就拒絕啟動。
#
# 【金鑰很可能是同一把，這點與 OKX 不同】
# OKX 的模擬盤是獨立環境，模擬金鑰物理上碰不到真實資金。
# BingX 的 VST 是同一個帳戶底下的一個虛擬餘額
#（資產 → 合約帳戶 → U 本位永續 → 虛擬 USDT），
# 文件也沒有提到要另外建金鑰 —— 也就是說決定真假的是「網域」，
# 不是金鑰。
#
# 後果：BINGX_BASE_URL 填錯就是真錢，金鑰本身給不了任何保護。
# 這正是上面那道開機檢查存在的理由，它是唯一的防線。
# 建立金鑰時「提現」權限務必關閉。
# BINGX_BASE_URL=

