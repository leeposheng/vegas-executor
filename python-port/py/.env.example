# ============================================================
# vegas-executor（Python）環境變數範本
# 只放「名稱與說明」。真正的值請直接填在 Zeabur 或終端機，
# 不要提交到版本庫、不要貼到聊天。
# ============================================================

# ---- 〇、服務本身（必填）----
# 兩把都要 ≥16 字元且互不相同；用 `py -m vegas_executor.webhook_admin gen-secret` 各產生一組。
# 這是 Python 服務自己的密鑰，與 Node 服務、TradingView 密鑰都不同。
EXECUTOR_WEBHOOK_SECRET=
EXECUTOR_CONTROL_SECRET=
DRY_RUN=true                     # 本服務維持 true；不要設任何交易所金鑰
# DATA_DIR=/data                 # Dockerfile 已預設；Zeabur 需掛載 Volume 到 /data

# ---- 一、Telegram 層（必填；缺任一個服務會拒絕啟動）----
BOT_ENABLED=true                 # true 才啟用 Telegram 層；不設或其他值＝關閉
TG_TOKEN=                        # 現有 bot 的 token（沿用 GAS 的 TG_TOKEN，不新建 bot）
ALLOWED_CHAT_ID=                 # 私訊／操作者聊天室 ID
TRADINGVIEW_WEBHOOK_SECRET=      # 沿用 GAS 現值，TradingView 警報網址才不用改密鑰
TELEGRAM_WEBHOOK_SECRET=         # 沿用 GAS 現值

# ---- 二、Telegram 層（選填）----
SIGNAL_CHAT_ID=                  # 群組廣播的群組 ID
SIGNAL_THREAD_ID=                # 群組主題（topic）ID
OPERATOR_USER_IDS=               # 可按確認鍵的使用者 ID，逗號分隔
ANTHROPIC_API_KEY=               # Telegram 對話問答用

# ---- 三、圖表（CHART-IMG）----
# 不設 CHART_IMG_API_KEY ＝ 停用圖表，卡片只發純文字。
# 下方選填項目名稱與 GAS 相同；沒設就用括號內預設值，建議照 GAS 現值複製。
CHART_IMG_API_KEY=
#CHART_MAX_PARAMS=3              # 方案額度：BASIC 3 / PRO 5 / MEGA 10（夾在 1–10）
#CHART_THEME=dark                # dark 或 light
#CHART_WIDTH=800                 # 320–1920
#CHART_HEIGHT=600                # 240–1600
#CHART_TV_EXCHANGE=OKX
#CHART_EMA_ORDER=144,169,576,676,250,288,12
#CHART_SHOW_LEVELS=false         # true/1/on 才在圖上畫 ENTRY/SL/TP 水平線
#CHART_LEVEL_SET=entry,sl,tp1    # entry,sl,tp1,tp2,tp3 或 none / all
#CHART_EMA_COLORS=               # 例：144:#2B4C7E,576:#7D2E3A
#CHART_LEVEL_COLORS=             # 例：entry:#FFFFFF,sl:#A32E3E,tp:#1F7A5E
#CHART_LEVEL_TEXT_COLORS=
#CHART_LEVEL_TEXT_FIELD=textColor
#CHART_CANDLE_UP=rgb(8,153,129)
#CHART_CANDLE_DOWN=rgb(242,54,69)
#CHART_HIDE_LEGEND_KEYS=showSeriesOHLC,showBarChange   # none＝不動圖例
#CHART_WATERMARK=               # 0–100 透明度；空白＝不開
#CHART_EMA_STUDY_NAME=Moving Average Exponential

# ---- 四、執行層既有設定（維持現狀，這裡只提醒）----
# EXECUTION_MODE=manual
# 交易所金鑰、其餘既有變數：沿用 Zeabur 上現有設定，不在此重複。

# ---- 五、只在終端機執行 webhook_admin 時需要（不用設在 Zeabur）----
# python -m vegas_executor.webhook_admin <check|diagnose|tv-url|gen-secret|set|reset|reset-drop>
# 除上面第一區的變數外，另需：
# WEBAPP_URL=https://<Python 服務網域>/   # Telegram 更新要送去哪裡；回退時改成 GAS 網址再 set
